# Required Tokens
DISCORD_TOKEN=your_discord_bot_token_here
REVOLT_TOKEN=your_revolt_bot_token_here

# Revolt API Configuration
API_URL=https://api.revolt.chat
REVOLT_ATTACHMENT_URL=https://autumn.revolt.chat

# Image Upload Configuration (Optional)
UPLOAD_IMAGES_TO_REVOLT=true
MAX_IMAGE_SIZE_MB=10
SUPPORTED_IMAGE_FORMATS=jpeg,jpg,png,gif,webp
IMAGE_UPLOAD_TIMEOUT_MS=30000
FALLBACK_TO_URL_ON_ERROR=true

# Emoji Sync Configuration (Optional)
# Enabled by default - Discord emojis will be synced to Revolt servers
SYNC_EMOJIS_TO_REVOLT=true
MAX_EMOJI_SIZE_MB=5
EMOJI_CACHE_EXPIRY_DAYS=7
EMOJI_FALLBACK_TO_LINK=true

# Debug Mode (Optional)
DEBUG=0
